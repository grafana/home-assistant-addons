import.git "grafana_cloud" {
  repository = "https://github.com/grafana/alloy-modules.git"
  path = "modules/cloud/grafana/cloud/module.alloy"
  revision = "9c838a1fd98962edf80393cf5f5f94bbb416ecc1" // v0.2.11
  pull_frequency = "0s"
}

grafana_cloud.stack "receivers" {
  stack_name = sys.env("STACK_NAME")
  token = sys.env("ACCESS_TOKEN")
}

logging {
  level    = "info"
  format   = "logfmt"
  write_to = [loki.process.alloy.receiver]
}

loki.process "alloy" {
  forward_to = [grafana_cloud.stack.receivers.logs]
  stage.static_labels {
    values = {
      instance = sys.env("INSTANCE_NAME"),
    }
  }
}

prometheus.scrape "alloy" {
  forward_to = [grafana_cloud.stack.receivers.metrics]
  targets = [
    {
      "__address__" = "0.0.0.0:80",
      "instance" = sys.env("INSTANCE_NAME"),
    },
  ]
  scrape_interval = sys.env("SCRAPE_INTERVAL")
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_syslog_identifier"]
    regex = sys.env("LOG_IDENTIFIERS")
    action = "keep"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    regex = sys.env("SELF_IDENTIFIERS")
    action = "drop"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label = "component"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label = "job"
  }
}

loki.source.journal "homeassistant" {
  forward_to = [loki.process.homeassistant.receiver]
  // Without an explicit path the journal is opened by machine ID, which never
  // matches the one generated for this container, and no entries are read.
  path = sys.env("JOURNAL_PATH")
  relabel_rules = loki.relabel.journal.rules
  labels = {
    instance = sys.env("INSTANCE_NAME"),
  }
}

loki.process "homeassistant" {
  forward_to = [grafana_cloud.stack.receivers.logs]
  // Home Assistant colourises its console output. The capture group is required,
  // stage.replace only rewrites captured groups.
  stage.replace {
    expression = "(\\x1b\\[[0-9;]*m)"
    replace = ""
  }
  stage.multiline {
    firstline = "^\\d{4}-\\d{2}-\\d{2} \\d{1,2}:\\d{2}:\\d{2}\\.\\d{3} "
    max_lines = 1000
  }
}

prometheus.scrape "homeassistant" {
  forward_to = [grafana_cloud.stack.receivers.metrics]
  targets = [
    {
      "__address__" = "supervisor:80",
      "instance" = sys.env("INSTANCE_NAME"),
    },
  ]
  scrape_interval = sys.env("SCRAPE_INTERVAL")
  metrics_path = "/core/api/prometheus"
  bearer_token = sys.env("SUPERVISOR_TOKEN")
  scheme = "http"
}
